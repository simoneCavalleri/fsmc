@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
include(FindPackageHandleStandardArgs)

if(NOT EMSCRIPTEN)
    find_dependency(Threads)
endif()
if(@ZLIB_FOUND@)
    find_dependency(ZLIB)
endif()

# Include the exported targets
if(NOT TARGET fsmc::fsmc_runtime)
    include("${CMAKE_CURRENT_LIST_DIR}/fsmcTargets.cmake")
endif()

# Define documented alias targets for installed consumers
if(TARGET fsmc::fsmc_runtime AND NOT TARGET fsmc::runtime)
    add_library(fsmc::runtime ALIAS fsmc::fsmc_runtime)
endif()
if(TARGET fsmc::fsmc_core AND NOT TARGET fsmc::core)
    add_library(fsmc::core ALIAS fsmc::fsmc_core)
endif()
if(TARGET fsmc::fsmc_core AND NOT TARGET fsmc::ir)
    add_library(fsmc::ir ALIAS fsmc::fsmc_core)
endif()
if(TARGET fsmc::fsmc_frontend AND NOT TARGET fsmc::frontend)
    add_library(fsmc::frontend ALIAS fsmc::fsmc_frontend)
endif()
if(TARGET fsmc::fsmc_middleend AND NOT TARGET fsmc::middleend)
    add_library(fsmc::middleend ALIAS fsmc::fsmc_middleend)
endif()
if(TARGET fsmc::fsmc_backend AND NOT TARGET fsmc::backend)
    add_library(fsmc::backend ALIAS fsmc::fsmc_backend)
endif()
if(TARGET fsmc::fsmc_compiler AND NOT TARGET fsmc::compiler)
    add_library(fsmc::compiler ALIAS fsmc::fsmc_compiler)
endif()

# Include the code generation helpers
include("${CMAKE_CURRENT_LIST_DIR}/FsmcTools.cmake")

set(fsmc_FOUND TRUE)
