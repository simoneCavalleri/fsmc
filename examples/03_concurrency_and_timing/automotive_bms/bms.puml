@startuml BatteryManagementSystem
skinparam monochrome true
skinparam state {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}

' ============================================================================
' PlantUML Model: High-Voltage Automotive BMS (ISO 26262 ASIL-D)
' Demonstrating: Parallel Orthogonal Regions, Clocks, Time Invariants, Race Checking
' ============================================================================

' Typed MBSE I/O Ports with range bounds
' @fsm:port name=pack_voltage_v type=float32 dir=in min=250.0 max=450.0
' @fsm:port name=max_cell_temp_c type=float32 dir=in min=-20.0 max=65.0
' @fsm:port name=isolation_resistance_kohm type=float32 dir=in min=100.0 max=10000.0
' @fsm:port name=cooling_pump_pwm type=float32 dir=out min=0.0 max=100.0
' @fsm:port name=contactors_closed type=bool dir=out
' @fsm:port name=balancing_active type=bool dir=out

[*] --> Standby

Standby --> Operational : PrechargeCompleteCmd / CloseMainContactorsAction

state Operational {
    state ThermalSupervision {
        [*] --> ThermalNominal
        ThermalNominal : stay <= 100ms
        ActiveCooling : stay <= 50ms
        state ThermalDerating

        ThermalNominal --> ActiveCooling : (prio=5) HighTempWarningEvent / RampCoolingPumpAction
        ActiveCooling --> ThermalDerating : (prio=2) CriticalTempEvent / ThrottleDischargeAction
        ActiveCooling --> ThermalNominal : (prio=5) TempNominalEvent / StopCoolingPumpAction
        ThermalDerating --> ActiveCooling : (prio=5) TempNominalEvent / RampCoolingPumpAction
    }
    --
    state CellBalancing {
        [*] --> BalancingIdle
        BalancingActive : stay <= 500ms

        BalancingIdle --> BalancingActive : (prio=5) DeltaVThresholdExceededEvent / EnableBalanceShuntsAction
        BalancingActive --> BalancingIdle : (prio=5) CellsBalancedEvent / DisableBalanceShuntsAction
    }
    --
    state IsolationMonitoring {
        [*] --> IsoHealthy
        IsoHealthy : stay <= 200ms

        IsoHealthy --> IsoWarning : (prio=5) LowIsolationResistanceEvent / AlertVehicleMasterAction
        IsoWarning --> IsoHealthy : (prio=5) IsolationRestoredEvent / ClearVehicleAlertAction
    }
}

state FaultShutdown {
    FaultShutdown : entry / OpenMainContactorsAction
}

Operational --> FaultShutdown : (prio=1) ThermalRunawayFault / OpenMainContactorsAction
Operational --> FaultShutdown : (prio=1) HvInterlockBreachedFault / OpenMainContactorsAction

@enduml
