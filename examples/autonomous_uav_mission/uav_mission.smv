-- ============================================================================
-- nuXmv / SMV Formal Verification Model: AutonomousUavMission
-- Generated automatically by fsmc (https://github.com/simoneCavalleri/fsmc)
-- ============================================================================

MODULE main

VAR
  state : {FailSafe, Landed, ReturnToHome, SafeLanding, InFlight, Ascending, HoverPause, Navigating, SearchPattern, WaypointNav, Preflight, SensorCalib, SystemReady, Terminal, FinalShutdown};
  event : {none, CalibrationOk, AreaReached, NextSectorCmd, TargetAltitudeReached, PauseCmd, ResumeMissionCmd, HomePointReached, TouchdownEvent, TakeoffCmd, LowBatteryEvent, AbortCmd, ShutdownCmd, EvTelemetryPing, EvCameraSnap};
  altitude_m : 0..100;
  battery_percent : 0..100;
  retry_count : 0..100;
  waypoints_completed : 0..100;
  HasGpsLockGuard : boolean; -- input guard condition

ASSIGN
  init(state) := Preflight;
  init(altitude_m) := 0;
  init(battery_percent) := 100;
  init(retry_count) := 0;
  init(waypoints_completed) := 0;

  next(state) := case
    state = SensorCalib & event = CalibrationOk : SystemReady; -- action: ArmMotors
    state = WaypointNav & event = AreaReached : SearchPattern; -- action: EnableSensors
    state = SearchPattern & event = NextSectorCmd : WaypointNav; -- action: LogSectorCompleted
    state = Ascending & event = TargetAltitudeReached : Navigating; -- action: StartNavigation
    state = Navigating & event = PauseCmd : HoverPause; -- action: HoldPosition
    state = HoverPause & event = ResumeMissionCmd : Navigating; -- action: ResumeNavigation
    state = ReturnToHome & event = HomePointReached : SafeLanding; -- action: DescendMotors
    state = SafeLanding & event = TouchdownEvent : Landed; -- action: DisarmMotors
    state = Preflight & event = TakeoffCmd & (HasGpsLockGuard) : InFlight; -- action: LaunchUav
    state = InFlight & event = LowBatteryEvent : FailSafe; -- action: InitiateFailSafe
    state = InFlight & event = AbortCmd : FailSafe; -- action: InitiateFailSafe
    state = FailSafe & event = ShutdownCmd : Terminal; -- action: PowerOff
    TRUE : state;
  esac;

-- ============================================================================
-- Formal Specifications & Verification Goals
-- ============================================================================

INVARSPEC -- DisjointPreflightFlight
  !((state = Preflight & state = InFlight));

LTLSPEC -- MissionTerminationReached
  F (state = Landed);

LTLSPEC -- SafeLandingOnLowBattery
  G ((event = LowBatteryEvent -> F (state = SafeLanding)));

