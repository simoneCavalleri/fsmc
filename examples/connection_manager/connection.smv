-- ============================================================================
-- nuXmv / SMV Formal Verification Model: ConnectionFSM
-- Generated automatically by fsmc (https://github.com/simoneCavalleri/fsmc)
-- ============================================================================

MODULE main

VAR
  state : {Connected, Connecting, Disconnected, Suspended};
  event : {none, ConnectCmd, HandshakeOkEvent, HandshakeFailedEvent, TimeoutEvent, NetworkDegradedEvent, DisconnectCmd, ConnectionLostEvent, NetworkRestoredEvent};
  HasNetworkGuard : boolean; -- input guard condition
  HasValidCredentialsGuard : boolean; -- input guard condition

ASSIGN
  init(state) := Disconnected;

  next(state) := case
    state = Disconnected & event = ConnectCmd & ((HasNetworkGuard & HasValidCredentialsGuard)) : Connecting; -- action: InitSocketAction
    state = Disconnected & event = ConnectCmd & ((!(HasNetworkGuard) | !(HasValidCredentialsGuard))) : Disconnected; -- action: LogErrorAction
    state = Connecting & event = HandshakeOkEvent : Connected; -- action: SetupSessionAction
    state = Connecting & event = HandshakeFailedEvent : Disconnected; -- action: CleanupAction
    state = Connecting & event = TimeoutEvent : Disconnected; -- action: CleanupAction
    state = Connected & event = NetworkDegradedEvent : Suspended; -- action: PauseQueueAction
    state = Connected & event = DisconnectCmd : Disconnected; -- action: CloseSocketAction
    state = Connected & event = ConnectionLostEvent : Disconnected; -- action: CleanupAction
    state = Suspended & event = NetworkRestoredEvent : Connected; -- action: ResumeQueueAction
    state = Suspended & event = DisconnectCmd : Disconnected; -- action: CloseSocketAction
    state = Suspended & event = TimeoutEvent : Disconnected; -- action: CleanupAction
    TRUE : state;
  esac;

