-- ============================================================================
-- nuXmv / SMV Formal Verification Model: MissionFSM
-- Generated automatically by fsmc (https://github.com/simoneCavalleri/fsmc)
-- ============================================================================

MODULE main

VAR
  state : {Aborted, InFlight, Ascending, Cruising, Orbiting, Landing, MissionCompleted, SignalLost, Standby, Calibrated, Diagnostics};
  event : {none, CalibrationOkEvent, AltitudeReachedEvent, OrbitInsertedEvent, PingTelemetry, LinkDegradedEvent, LinkRestoredEvent, ReturnHomeCmd, TouchdownEvent, AuthorizeCmd, LaunchCmd};
  NoClearanceGuard : boolean; -- input guard condition
  ValidClearanceGuard : boolean; -- input guard condition

ASSIGN
  init(state) := Diagnostics;

  next(state) := case
    state = Diagnostics & event = CalibrationOkEvent : Calibrated; -- action: LogCalibrationAction
    state = Ascending & event = AltitudeReachedEvent : Cruising; -- action: DeploySolarPanelsAction
    state = Cruising & event = OrbitInsertedEvent : Orbiting; -- action: StabilizeAttitudeAction
    state = Orbiting & event = PingTelemetry : Orbiting; -- action: LogTelemetryAction
    state = Orbiting & event = LinkDegradedEvent : SignalLost; -- action: BufferCommandsAction
    state = SignalLost & event = LinkRestoredEvent : Orbiting; -- action: SyncClockAction
    state = Orbiting & event = ReturnHomeCmd : Landing; -- action: RetractPanelsAction
    state = Landing & event = TouchdownEvent : MissionCompleted; -- action: ShutdownSystemsAction
    state = Calibrated & event = AuthorizeCmd & (ValidClearanceGuard) : Ascending; -- action: ArmEnginesAction
    state = Calibrated & event = AuthorizeCmd & (NoClearanceGuard) : Aborted; -- action: TriggerAlarmAction
    TRUE : state;
  esac;

