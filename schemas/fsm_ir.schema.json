{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simoneCavalleri/fsmc/schemas/fsm_ir.schema.json",
  "title": "fsmc Canonical FsmIr Schema (v1.0)",
  "description": "Canonical JSON Intermediate Representation exchanged between external MBSE/SysML parsers, fsm-opt, model checkers, and fsmc codegen backends.",
  "type": "object",
  "required": ["ir_schema_version", "name", "states"],
  "additionalProperties": false,
  "properties": {
    "ir_schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version identifier for fail-closed ingestion."
    },
    "id": { "type": "string" },
    "fsm_id": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "initial": { "type": "string" },
    "initial_state": { "type": "string" },
    "initial_state_id": { "type": "string" },
    "package": { "type": "string" },
    "source_file": { "type": "string" },
    "satisfies_reqs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "dispatch": { "type": "string" },
        "orthogonal_conflict": { "type": "string" },
        "datapath_isolation": { "type": "string" }
      }
    },
    "execution_semantics": { "type": "object" },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "direction"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "direction": { "type": "string", "enum": ["in", "out", "inout"] },
          "min": { "type": "number" },
          "min_value": { "type": "number" },
          "max": { "type": "number" },
          "max_value": { "type": "number" },
          "constraint": { "type": "string" },
          "default": { "type": "string" },
          "default_value": { "type": "string" },
          "unit": { "type": "string" },
          "physical_unit": { "type": "string" },
          "bound_to": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "init": { "type": "string" },
          "initial_value": { "type": "string" },
          "min": { "type": "number" },
          "min_value": { "type": "number" },
          "max": { "type": "number" },
          "max_value": { "type": "number" },
          "unit": { "type": "string" },
          "physical_unit": { "type": "string" },
          "register_index": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" }
        }
      }
    },
    "enums": { "type": "array", "items": { "type": "object" } },
    "structs": { "type": "array", "items": { "type": "object" } },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["enum", "struct", "alias"] },
          "underlying_type": { "type": "string" },
          "description": { "type": "string" },
          "is_datatype": { "type": "boolean" },
          "external_ref": {
            "type": "object",
            "required": ["module", "symbol"],
            "additionalProperties": false,
            "properties": {
              "module": { "type": "string", "minLength": 1 },
              "symbol": { "type": "string", "minLength": 1 }
            }
          },
          "literals": { "type": "array", "items": { "type": "object" } },
          "fields": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "custom_types": { "type": "array", "items": { "type": "object" } },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "default_value": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "guards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "raw_expression": { "type": "string" },
          "normalized_expression": { "type": "string" }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "raw_expression": { "type": "string" },
          "assignments": { "type": "array", "items": { "type": "object" } },
          "instructions": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "clocks": { "type": "array", "items": { "type": "object" } },
    "choice_nodes": { "type": "array", "items": { "type": "object" } },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "formula"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "formula": { "type": "string", "minLength": 1 },
          "traceability_req": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "bindings": { "type": "array", "items": { "type": "object" } },
    "services": { "type": "array", "items": { "type": "object" } },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "event": { "type": "string" },
          "kind": { "type": "string", "enum": ["external", "internal", "local", "External", "Internal", "Local"] },
          "guard": { "type": "string" },
          "action": { "type": "string" },
          "priority": { "type": "integer", "minimum": 0 },
          "target_is_history": { "type": "boolean" },
          "target_is_deep_history": { "type": "boolean" },
          "traceability_reqs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "states": {
      "oneOf": [
        { "type": "object" },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string", "minLength": 1 },
              "parent_state": { "type": "string" },
              "kind": { "type": "string" },
              "is_composite": { "type": "boolean" },
              "initial_sub_state": { "type": "string" },
              "has_history": { "type": "boolean" },
              "has_deep_history": { "type": "boolean" },
              "do_activity": { "type": "string" },
              "entry_actions": { "type": "array" },
              "exit_actions": { "type": "array" },
              "deferred_events": { "type": "array", "items": { "type": "string" } },
              "traceability_reqs": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      ]
    }
  }
}
